# Copy to .env and fill in.
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Postgres from docker-compose.yml
DATABASE_URL=postgresql://futures:futures@localhost:5442/futures

# Models (provider:model-id), all through OpenRouter
DF_REASONING_MODEL=openrouter:google/gemini-3.8-flash
DF_NARRATIVE_MODEL=openrouter:google/gemini-3.8-flash
# Rubric grader (not an Anthropic model: their structured output rejects the grader schema)
DF_GRADER_MODEL=openrouter:google/gemini-3.8-flash
# Hidden reasoning of the models: minimal, low, medium or high. Reasoning tokens are billed
# as output and count against the output limit.
DF_REASONING_EFFORT=low
# Activity log: every step, AI call (tokens, cost) and failure
DF_LOG_FILE=logs/digital_futures.log
